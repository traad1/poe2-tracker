# Copy this file to `.streamlit/secrets.toml` (which is gitignored) and fill in the values.
# On Streamlit Community Cloud, paste these into the app's "Secrets" UI instead.
#
# DATABASE_URL — Postgres connection string. Get one free at https://neon.tech.
# When unset, the app falls back to a local SQLite file at app/data/tracker.db.
# Accepted forms (the app normalizes both to postgresql+psycopg2://):
#   DATABASE_URL = "postgres://user:pass@host/dbname"
#   DATABASE_URL = "postgresql://user:pass@host/dbname?sslmode=require"

DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
